# ---- Supabase ----
SUPABASE_URL=https://your-project-ref.supabase.co
# Private key for trusted server operations; may bypass RLS. BACKEND ONLY.
# If your project only offers the legacy format, use the service role key value.
SUPABASE_SECRET_KEY=your-service-role-or-secret-key
# Public signing keys for token verification.
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Legacy fallback: HS256 JWT secret (only used if JWKS verification is unavailable).
SUPABASE_JWT_SECRET=

# ---- World Labs / Marble (3D preview) ----
# Platform API key (WLT-Api-Key) from https://platform.worldlabs.ai/api-keys.
WORLD_LABS_API_KEY=your-world-labs-key
WORLD_LABS_BASE_URL=https://api.worldlabs.ai
# marble-1.0 | marble-1.1 | marble-1.1-plus (larger worlds cost more credits).
WORLD_LABS_MODEL=marble-1.1

# ---- Weather ----
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# ---- n8n webhook ----
N8N_WEBHOOK_SECRET=change-me-to-a-random-string

# ---- App ----
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
APP_ENV=development

# Mock flags — keep true for a reliable demo with no external API dependency.
MOCK_WORLD_LABS=true
MOCK_WEATHER=true
